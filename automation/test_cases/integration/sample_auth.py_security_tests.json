    "test_id": "sec_001",
    "test_name": "test_sql_injection_in_authentication",
    "description": "Verify authentication system is protected against SQL injection attacks in username and password fields",
    "priority": "critical",
    "test_type": "security",
    "vulnerability_type": "SQL Injection",
    "owasp_category": "A03:2021 - Injection",
    "test_data": {
      "attack_vectors": [
        "' OR '1'='1",
        "admin'--",
        "' UNION SELECT * FROM users--",
        "admin' OR 1=1--",
        "'; DROP TABLE users--",
        "1' AND '1'='1",
        "' OR 'x'='x",
        "admin' /*",
        "' or 1=1#",
        "') OR ('1'='1"
      ],
      "expected_behavior": "All SQL injection attempts should be rejected without exposing database errors"
    },
    "assertions": [
      "Authentication fails for all SQL injection attempts",
      "No database errors exposed in response",
      "System logs security violation with attack vector details",
      "Response time consistent to prevent timing attacks",
      "No user enumeration possible through error messages"
    ],
    "severity": "critical",
    "tags": [
      "injection",
      "authentication",
      "owasp_top10",
      "sql_injection"
    ]
  },
