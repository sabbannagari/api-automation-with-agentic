{
  "api": {
    "base_url": "http://localhost:8000",
    "schema": "http://localhost:8000/openapi.json",
    "auth_type": null
  },
  "artifacts": {
    "base_dir": "test_case_artifacts",
    "mappings": {
      "openapi": {
        "patterns": ["*.json", "openapi.json", "swagger.json", "*openapi*.json", "*swagger*.json"],
        "agent": "openapi_test_generator",
        "description": "OpenAPI/Swagger specification files"
      },
      "functional": {
        "patterns": ["*functional*.md", "*functional*.pdf", "*functional*.txt", "*spec*.md", "*requirements*.md"],
        "agent": "functional_test_generator",
        "description": "Functional specification and requirements documents"
      },
      "security": {
        "patterns": ["*security*.md", "*security*.pdf", "*security*.txt", "*threat*.md", "*owasp*.md"],
        "agent": "security_test_generator",
        "description": "Security requirements and threat model documents"
      },
      "performance": {
        "patterns": ["*performance*.md", "*performance*.pdf", "*load*.md", "*benchmark*.md"],
        "agent": "performance_test_generator",
        "description": "Performance and load testing specifications"
      },
      "code": {
        "patterns": ["*.py", "*.js", "*.java", "*.go", "*.ts", "*.cpp", "*.c"],
        "agent": "code_test_generator",
        "description": "Source code files for test generation"
      }
    }
  },
  "test_types": {
    "integration": {
      "description": "Tests that verify interactions between different components/services",
      "output_dir": "test_cases/integration"
    },
    "component": {
      "description": "Tests that verify individual components in isolation",
      "output_dir": "test_cases/component"
    },
    "system": {
      "description": "End-to-end tests that verify the entire system",
      "output_dir": "test_cases/system"
    },
    "regression": {
      "description": "Tests to ensure new changes don't break existing functionality",
      "output_dir": "test_cases/regression"
    },
    "all": {
      "description": "Generate all types of tests",
      "output_dir": "test_cases/all"
    }
  },
  "agents": {
    "master": {
      "description": "Master orchestrator - artifact-driven test case generator",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0
    },
    "openapi_test_generator": {
      "description": "Generates test cases from OpenAPI specifications",
      "module": "agents.openapi_agent",
      "function": "generate_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0,
      "max_tokens": 16000,
      "prompt_template": "prompts/openapi_test_generator.txt",
      "capabilities": [
        "Parse OpenAPI/Swagger specifications",
        "Generate API test cases for all endpoints",
        "Create test scenarios for different HTTP methods",
        "Support authentication and authorization tests"
      ]
    },
    "functional_test_generator": {
      "description": "Generates test cases from functional specifications",
      "module": "agents.functional_agent",
      "function": "generate_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0.3,
      "max_tokens": 16000,
      "prompt_template": "prompts/functional_test_generator.txt",
      "capabilities": [
        "Parse functional specification documents",
        "Extract user requirements and acceptance criteria",
        "Generate functional test scenarios",
        "Create test cases for business logic validation"
      ]
    },
    "security_test_generator": {
      "description": "Generates security test cases from security documents",
      "module": "agents.security_agent",
      "function": "generate_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0,
      "max_tokens": 16000,
      "prompt_template": "prompts/security_test_generator.txt",
      "capabilities": [
        "Parse security requirements and threat models",
        "Generate OWASP Top 10 test cases",
        "Create authentication and authorization tests",
        "Generate input validation and injection tests"
      ]
    },
    "performance_test_generator": {
      "description": "Generates performance test cases from performance specs",
      "module": "agents.performance_agent",
      "function": "generate_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0,
      "max_tokens": 16000,
      "prompt_template": "prompts/performance_test_generator.txt",
      "capabilities": [
        "Parse performance requirements",
        "Generate load and stress test scenarios",
        "Create benchmark test cases",
        "Generate scalability tests"
      ]
    },
    "code_test_generator": {
      "description": "Generates test cases by analyzing source code",
      "module": "agents.code_agent",
      "function": "generate_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-sonnet-4-5-20250929",
      "temperature": 0.2,
      "max_tokens": 16000,
      "prompt_template": "prompts/code_test_generator.txt",
      "capabilities": [
        "Analyze source code structure",
        "Generate unit and integration tests",
        "Create test cases for edge cases and error handling",
        "Generate mock and stub requirements"
      ]
    },
    "test_case_executor": {
      "description": "Test case executor agent - executes test cases and generates reports",
      "module": "test_case_executor",
      "function": "execute_tests",
      "llm_vendor": "anthropic",
      "llm_model": "claude-haiku-4-5-20251001",
      "temperature": 0,
      "capabilities": [
        "Execute test cases by test type",
        "Validate API responses",
        "Generate JSON and HTML reports",
        "Support all HTTP methods (GET, POST, PUT, PATCH, DELETE)",
        "Handle authentication (basic, bearer, token)"
      ]
    }
  }
}
